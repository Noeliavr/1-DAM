<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE especie [
    <!ELEMENT especie (datos-especie, distribucion)>
    <!ATTLIST especie
              estado (extinto | amenazado | sin-peligro) "sin-peligro">

    <!ELEMENT datos-especie (nombre, familia)>

    <!ELEMENT nombre (#PCDATA)>
    <!ATTLIST nombre
              nombre-cientifico CDATA #REQUIRED>

    <!ELEMENT familia (#PCDATA)>

    <!ELEMENT distribucion (zona+)>
    <!ELEMENT zona (#PCDATA)>
]>
<especie estado="amenazado">
    <datos-especie>
        <nombre nombre-cientifico="Monachus monachus">Foca monje</nombre>
        <familia>Phocidae</familia>
    </datos-especie>
    <distribucion>
        <zona>Costa Atlántica</zona>
        <zona>Costa Mediterránea</zona>
    </distribucion>
</especie>
