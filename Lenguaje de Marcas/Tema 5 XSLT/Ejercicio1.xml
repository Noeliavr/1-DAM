<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

  <xsl:output method="html" encoding="UTF-8" indent="yes"/>

  <xsl:template match="/libreria">
    <html>
      <head>
        <meta charset="UTF-8"/>
        <title>Mi biblioteca</title>
        <style>
          body { font-family: "Times New Roman", serif; }
          h1 { margin: 0 0 14px 0; font-size: 44px; font-weight: 700; }
          table { border-collapse: collapse; width: 560px; }
          th {
            background: #6f6276; /* morado similar al ejemplo */
            color: #000;
            font-size: 20px;
            padding: 6px 10px;
            border: 1px solid #6f6276;
          }
          td {
            padding: 6px 10px;
            font-size: 18px;
            border-left: 1px solid #6f6276;
            border-right: 1px solid #6f6276;
          }
          tr:last-child td { border-bottom: 1px solid #6f6276; }
        </style>
      </head>

      <body>
        <h1>Mi biblioteca</h1>

        <table>
          <tr>
            <th style="width:75%;">Titulo</th>
            <th style="width:25%;">Autor</th>
          </tr>

          <xsl:for-each select="libro">
            <tr>
              <td><xsl:value-of select="normalize-space(titulo)"/></td>
              <td><xsl:value-of select="normalize-space(autor)"/></td>
            </tr>
          </xsl:for-each>
        </table>
      </body>
    </html>
  </xsl:template>

</xsl:stylesheet>
